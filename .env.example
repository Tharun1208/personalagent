# ==========================================
# ASSISTANCE AI ENVIRONMENT CONFIGURATION
# ==========================================

# Groq Cloud API Key (Get yours at https://console.groq.com)
GROQ_API_KEY=

# Google Gemini API Key (Get yours at https://aistudio.google.com)
GEMINI_API_KEY=

# OpenAI API Key (Optional)
OPENAI_API_KEY=

# Anthropic API Key (Optional)
ANTHROPIC_API_KEY=

# Application Secret
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Connection String (MongoDB Atlas or Local MongoDB):
# e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/assistance_ai?retryWrites=true&w=majority
MONGODB_URI=

# ==========================================
# GOOGLE DRIVE BACKUP (Optional)
# ==========================================
# Create an OAuth 2.0 Web client at https://console.cloud.google.com
# Enable the Google Drive API, then add these redirect URIs:
#   http://localhost:3000/api/google/callback
#   https://your-production-domain/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin used to build the OAuth redirect URI.
# Leave empty in local development (auto-detected from the request).
# APP_URL=https://your-production-domain
