// PostgreSQL Schema for Recall AI Production Deployment
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  avatar        String?
  passwordHash  String
  preferences   Json           @default("{}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  conversations Conversation[]
  messages      Message[]
  memories      Memory[]
  tasks         Task[]
  reminders     Reminder[]
  projects      Project[]
  agentActions  AgentAction[]
  notifications Notification[]
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String
  pinned    Boolean   @default(false)
  projectId String?
  model     String    @default("Recall Core Ultra")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  userId         String
  role           String
  content        String        @db.Text
  attachments    Json?
  toolSteps      Json?
  memorySaved    Json?
  createdAt      DateTime      @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Memory {
  id          String                  @id @default(cuid())
  userId      String
  content     String                  @db.Text
  type        String
  category    String?
  tags        String[]
  confidence  Float                   @default(1.0)
  pinned      Boolean                 @default(false)
  projectId   String?
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?   @db.Text
  status      String    @default("todo")
  priority    String    @default("medium")
  dueDate     DateTime?
  projectId   String?
  tags        String[]
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Reminder {
  id          String    @id @default(cuid())
  userId      String
  title       String
  dueDateTime DateTime
  recurrence  String    @default("none")
  priority    String    @default("medium")
  notes       String?   @db.Text
  status      String    @default("pending")
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String   @db.Text
  techStack   String[]
  repository  String?
  status      String   @default("active")
  notes       String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AgentAction {
  id              String   @id @default(cuid())
  userId          String
  conversationId  String?
  toolName        String
  action          String
  summary         String
  status          String
  permissionLevel String
  details         Json?
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
